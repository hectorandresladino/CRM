# Auto-detect text files
* text=auto

# Source files - enforce LF in repo, CRLF on Windows checkout
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.ini text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.jar binary
*.class binary
*.keystore binary
*.jks binary
